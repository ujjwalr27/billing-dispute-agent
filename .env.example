# PostgreSQL connection string.
# - Docker Compose sets this automatically for the app container (host db:5432).
# - For local `npm run dev`, start just the database with `docker compose up -d db`;
#   it is published on host port 5433, so use the localhost URL below.
DATABASE_URL="postgresql://billing:billing@localhost:5433/billing?schema=public"

# Gemini API key. OPTIONAL — if unset, the app uses a deterministic mock agent
# so the full flow still runs and all tests pass without a key.
GEMINI_API_KEY=""

# Which agent provider to use: "gemini" | "mock" | "auto"
# "auto" uses Gemini when GEMINI_API_KEY is set, otherwise the mock.
AGENT_PROVIDER="auto"

# Gemini model name (used only when the gemini provider is active).
GEMINI_MODEL="gemini-3.6-flash"

# Comma-separated models tried (after retries) if the primary model is
# overloaded or rate-limited, before falling back to the mock agent.
GEMINI_FALLBACK_MODELS="gemini-3.1-flash-lite"
